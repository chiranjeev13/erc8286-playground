{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev && cd site && npm ci --include=dev",
  "buildCommand": "cd site && npm run build",
  "outputDirectory": "site/dist",
  "functions": {
    "api/pg/[[...route]].ts": {
      "maxDuration": 60
    }
  }
}
